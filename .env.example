# SQLite by default. For Render, point this at the mounted disk (see README)
# or swap in a managed Postgres URL.
DATABASE_URL=sqlite:///./entertainment_os.db

# Comma-separated list of origins allowed to call this API.
# In production, set this to your deployed Vercel URL.
CORS_ORIGINS=http://localhost:3000

# Optional: local-dev fallback TMDb key. In the deployed app, the key
# entered on the Settings page (stored in the database) always takes
# priority over this.
TMDB_API_KEY=
